# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Cloud -> App -> Settings -> Secrets. Never commit the real file.

GROQ_API_KEY = "gsk_..."          # https://console.groq.com/keys

# Optional -- only needed if you pick these providers in the sidebar:
# GEMINI_API_KEY = ""             # https://aistudio.google.com/apikey
# OPENROUTER_API_KEY = ""         # https://openrouter.ai/keys
# ANTHROPIC_API_KEY = ""          # https://console.anthropic.com/settings/keys

# ---------------------------------------------------------------- billing config
# Who pays for each phone line and who gets the bill email. Instead of editing this
# by hand you can upload a bill in the app, fill in the onboarding table, and click
# "Download billing config". The same block can also be uploaded in the sidebar.
#
# split = "shared" : plan cost is pooled with the account charge and split equally
#                    across all shared lines (default).
# split = "own"    : the line pays exactly its own charges (e.g. a kids watch).

[billing]
owner_name = "Your Name"     # used in the email signature
due_day = 6                  # bill due day of month

[[billing.members]]
name = "Alice"
emails = ["alice@example.com"]
lines = [
  { phone = "(555) 000-1111", label = "Alice", split = "shared" },
  { phone = "(555) 000-2222", label = "Alice Spouse", split = "shared" },
]

[[billing.members]]
name = "Bob"
emails = ["bob@example.com"]
lines = [
  { phone = "(555) 000-3333", label = "Bob", split = "shared" },
  { phone = "(555) 000-4444", label = "Bob Kid Watch", split = "own" },
]
